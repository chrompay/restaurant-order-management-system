{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],

    "module": "ESNext",
    "moduleResolution": "Bundler",
    "ignoreDeprecations": "6.0",

    "jsx": "react-jsx",

    "strict": true,

    "allowJs": false,
    "skipLibCheck": true,

    "resolveJsonModule": true,
    "isolatedModules": true,

    "noEmit": true,

    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,

    "baseUrl": "./src",

    "paths": {
      "@/*": ["*"]
    }
  },

  "include": ["src"],

  "exclude": [
    "node_modules",
    "dist"
  ]
}